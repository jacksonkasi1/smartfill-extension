{
  "name": "smartfill-lite",
  "displayName": "SmartFill – AI Form Filler & Test Data Generator",
  "version": "1.1.0",
  "description": "SmartFill: one-click form filler. Autofill any form with realistic test data for 20 industries, or with AI (OpenAI, Claude, Gemini).",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/"
  },
  "keywords": ["smartfill", "form-filler", "autofill", "test-data", "mock-data", "fake-data", "ai"],
  "author": "SmartFill Team",
  "license": "ISC",
  "type": "module",
  "manifest": {
    "name": "SmartFill – AI Form Filler & Test Data Generator",
    "permissions": ["storage", "activeTab", "scripting"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "commands": {
      "fill-form": {
        "suggested_key": { "default": "Alt+Shift+F", "mac": "Alt+Shift+F" },
        "description": "Fill the current page with SmartFill"
      }
    }
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "plasmo": "^0.90.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

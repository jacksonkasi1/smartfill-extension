# SmartFill Lite — environment variables
#
# The extension itself stores all user settings (provider, model, API key)
# locally in `chrome.storage.sync`. There is no backend, no auth service,
# and no shared secret. The values below are for the other apps in the
# monorepo (the RAG service, the marketing website) which are NOT used by
# the SmartFill Lite extension.

# OpenAI API (used by the optional RAG service, NOT by SmartFill Lite)
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Environment
NODE_ENV=development
